# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/a_plus_dashboard?schema=public"

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# App
NODE_ENV="development"

# OpenRouter — powers "Analyze with AI" on uploaded DNA test report PDFs
# (extracts structured results shown in the 6-category dashboard view).
# Get a key at https://openrouter.ai/keys. Without it, uploads still work
# but the analyze endpoint returns a clear "not configured" error.
OPEN_ROUTER_API_KEY=""

# Firebase Cloud Messaging (web push notifications). Client config comes
# from Firebase Console -> Project Settings -> General -> Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Web push certificate (VAPID key) — Project Settings -> Cloud Messaging -> Web configuration.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Firebase Admin SDK service account (JSON, single line) — required to
# actually SEND pushes from the server. Without it, tokens still register
# but sendPushToUser() no-ops. Get one at:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Chrono Diali (courier) — dispatches pickups and tracks the box on its
# way to the lab. Without CHRONO_DIALI_API_KEY, request-pickup falls back
# to local-only tracking (same as before this integration existed).
CHRONO_DIALI_API_KEY=""
CHRONO_DIALI_CUSTOMER_CODE=""
CHRONO_DIALI_BASE_URL="https://app.shipsy.in"
CHRONO_DIALI_WEBHOOK_SECRET=""

# Destination address for every pickup — the lab itself.
LAB_ADDRESS_NAME=""
LAB_ADDRESS_PHONE=""
LAB_ADDRESS_LINE1=""
LAB_ADDRESS_CITY=""
LAB_ADDRESS_COUNTRY="Morocco"
