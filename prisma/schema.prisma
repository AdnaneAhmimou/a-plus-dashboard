generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ADMIN
  SUPER_ADMIN
}

// Lifecycle of a patient's DNA test box, from pickup request to results.
// Lives on Box (not User) because the box is the physical object that
// actually moves through this pipeline.
enum KitStatus {
  NOT_REQUESTED
  PICKUP_REQUESTED
  PICKED_UP
  IN_TRANSIT
  TESTING
  RESULTS_READY
}

// Inventory lifecycle: AVAILABLE (in the lab, unused) -> SENT (handed to a
// courier / on its way to a prospective client, no account yet) ->
// ASSOCIATED (a patient has registered with this box's number).
enum BoxStatus {
  AVAILABLE
  SENT
  ASSOCIATED
  // The patient deleted their account, so the box is detached and its
  // results are gone. It is NOT returned to AVAILABLE: the physical kit
  // has been used, and leaving the number claimable would let a stranger
  // who guessed it register against a box that once held someone's
  // genetic data.
  RETIRED
}

model Box {
  id     String    @id @default(cuid())
  number String    @unique
  status BoxStatus @default(AVAILABLE)

  kitStatus         KitStatus @default(NOT_REQUESTED)
  pickupRequestedAt DateTime?
  pickedUpAt        DateTime?
  inTransitAt       DateTime?
  testingAt         DateTime?
  resultsReadyAt    DateTime?

  // Chrono Diali courier identifiers, set once a pickup is actually
  // requested through their API. courierReferenceNumber is the
  // consignment id — what tracking and the webhook key off of.
  courierReferenceNumber String? @unique
  courierPickupId        String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  reports         Report[]
  analysisResults AnalysisResult[]
  courierEvents   CourierEvent[]
  ancestryProfile AncestryProfile?
  resultImports   ResultImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("boxes")
}

// Raw webhook events from Chrono Diali, kept for audit/debugging. Their
// event `type` doesn't map 1:1 to our KitStatus (many, like
// "assigned_courier_partner" or "on_hold", have no forward-progress
// equivalent in our pipeline) — this preserves what we actually received
// even when a given event was a no-op for KitStatus purposes.
model CourierEvent {
  id      String @id @default(cuid())
  type    String
  payload Json

  box   Box?    @relation(fields: [boxId], references: [id], onDelete: SetNull)
  boxId String?

  createdAt DateTime @default(now())

  @@index([boxId])
  @@map("courier_events")
}

// A DNA test report PDF for a box. Multiple rows per box = version
// history (never overwritten in place); the highest `version` for a box
// is the current one. Stored as bytes directly in Postgres rather than
// on local disk or an external bucket — there's no cloud storage
// credentials configured for this project, and local-disk storage would
// silently break on any deployment target with an ephemeral filesystem.
// Report PDFs at this scale (one per patient test, occasional re-issues)
// are small enough that this is a legitimate, portable choice.
model Report {
  id       String @id @default(cuid())
  version  Int
  fileName String
  fileSize Int
  content  Bytes

  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  analysisResults AnalysisResult[]

  createdAt DateTime @default(now())

  @@unique([boxId, version])
  @@index([boxId])
  @@map("reports")
}

// The 6 fixed sections of the structured results view (mirrors the
// reference genetic-testing platform's report layout). Fixed rather than
// admin-defined because the AI extraction prompt targets exactly these six.
enum AnalysisCategory {
  HEALTH_CONDITIONS
  HEREDITARY_CONDITIONS
  PHARMACOLOGY
  TRAITS
  WELLNESS
  ANCESTRY
}

// One trait/condition analysis within a category (e.g. "Acne vulgaris" under
// Traits). Populated by AI extraction from an uploaded report PDF — see
// src/lib/ai/extract-analysis.ts. Re-analyzing a report replaces the box's
// entire result set (see the analyze route) rather than accumulating, so a
// box always has exactly one current set of structured results, sourced
// from whichever report was most recently analyzed.
model AnalysisResult {
  id       String           @id @default(cuid())
  category AnalysisCategory
  name     String
  summary  String

  description    String? @db.Text // "what is this" intro paragraph
  // The population-context sentence that follows the result headline in
  // the source PDF (e.g. "90% of the world's population has a medium
  // risk..."). Kept separate from `description` because the detail UI
  // renders it as its own population-context panel, and the percentage
  // inside it drives that panel's chart.
  resultContext  String? @db.Text
  probabilities  Json? // [{ label: string, percent: number }]
  variantCount   String? // kept as free-form string — source PDFs format this inconsistently (e.g. "13.5 million")
  riskLociCount  Int?
  genesAnalyzed  String? @db.Text
  technicalNotes String? @db.Text // "Technical report" section
  bibliography   Json? // [{ label: string, url?: string }]

  // Patient-facing explanatory sections — deterministically extracted
  // verbatim from the source PDF (see src/lib/ai/prepare-report-text.ts),
  // not AI-generated. Any of these can be absent depending on the report
  // type (e.g. a carrier-status report has no "Prevention" section).
  causesAndRiskFactors String? @db.Text
  symptoms             String? @db.Text
  prevention           String? @db.Text
  diseaseManagement    String? @db.Text
  studyLimitations     String? @db.Text

  // The source's own identifier for this result (e.g. tellmeGen's
  // "61/0"). Set only for imported results; null for ones extracted from
  // an uploaded PDF. Re-importing upserts on (boxId, externalId) so a
  // second run updates rows instead of duplicating them.
  externalId String?
  sourceUrl  String?

  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId String

  sourceReport   Report? @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  sourceReportId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boxId, externalId])
  @@index([boxId])
  @@index([boxId, category])
  @@map("analysis_results")
}

// The Ancestry category is a different shape from every other one: it is
// ONE profile per patient with four facets (composition, maternal line,
// paternal line, Neanderthal), not a list of individual traits. So it
// gets its own model rather than being forced into AnalysisResult rows,
// and the Ancestry card routes to a dedicated four-tab page instead of
// the generic per-trait list.
model AncestryProfile {
  id String @id @default(cuid())

  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId String @unique

  // Nested breakdown, three levels deep, mirroring the source:
  // [{ name: "Europe", percent: 81.4, children: [
  //     { name: "Iberian Peninsula", percent: 48.4, children: [
  //         { name: "Portugal", percent: 43.4, detected: true } ] } ] }]
  // Top-level percents sum to ~100. Names are the source's own labels;
  // the globe looks their coordinates up (see ancestry-geo.ts) and skips
  // any it doesn't know rather than guessing a location.
  composition Json

  maternalHaplogroup    String?
  maternalSubhaplogroup String?
  // [{ era: "more than 150,000 years ago", haplogroup: "L", description?: "..." }]
  // in chronological order — the migration path drawn on the globe.
  maternalMigration     Json?

  // Null for female patients: the Y chromosome isn't present, so the
  // paternal line can only come from a male relative's test.
  paternalHaplogroup    String?
  paternalSubhaplogroup String?
  paternalMigration     Json?

  neanderthalPercent   Float? // e.g. 1.5 (% of genome)
  neanderthalVariants  Int? // e.g. 418 variants detected
  neanderthalVsAverage Float? // e.g. 5.29 (% more than the average client; negative = less)
  // [{ title: "Origin and extinction", text: "..." }] — the source's
  // educational sections, verbatim.
  neanderthalSections  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ancestry_profiles")
}

// Where a patient's results came from. PORTAL is the Playwright import
// that drives the professionals portal with the lab's own credentials;
// API is the same data pulled from tellmeGen's API once they publish
// one. Both produce identical rows, so the switch is a config change.
enum ImportSource {
  TELLMEGEN_PORTAL
  TELLMEGEN_API
}

enum ImportStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

// One run of the importer against one box. Kept as a record (rather than
// just overwriting results) so an admin can see when a patient's data was
// last pulled, how much came back, and what failed if anything did.
model ResultImport {
  id      String       @id @default(cuid())
  source  ImportSource
  status  ImportStatus @default(RUNNING)
  barcode String

  itemsFound    Int @default(0)
  itemsImported Int @default(0)
  error         String? @db.Text

  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId String

  captures SourceCapture[]

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([boxId])
  @@map("result_imports")
}

// The raw text of one captured source page, stored verbatim before any
// parsing. Scraping is the slow and fragile step; parsing is cheap. With
// the raw text kept, improving how we read a field means re-parsing in
// seconds instead of driving the portal again for hours.
model SourceCapture {
  id         String @id @default(cuid())
  section    String // the source's section key, e.g. "diseases"
  externalId String // the source's own id for the item, e.g. "61/0"
  url        String
  rawText    String @db.Text

  import   ResultImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  importId String

  createdAt DateTime @default(now())

  @@unique([importId, section, externalId])
  @@index([importId])
  @@map("source_captures")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(PATIENT)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Pickup address for the courier integration (Chrono Diali) — not
  // collected at registration, only needed once a patient actually
  // requests a pickup. Nullable: most of the flow works without it, and
  // the pickup form asks for it inline the first time it's missing.
  addressLine1 String?
  city         String?
  country      String? @default("Morocco")

  box Box?

  uploadedReports Report[]
  notifications   Notification[]
  pushTokens      PushToken[]

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// In-app notifications for a patient's box status changing. This is the
// always-on channel — it never depends on external credentials. Firebase
// web push (below) is a best-effort addition on top of it: every
// notification created here also triggers a push if the user has
// registered a device and a Firebase Admin service account is configured.
// Deliberately scoped to patients: admins don't need to be notified about
// actions they themselves just took.
model Notification {
  id      String  @id @default(cuid())
  message String
  read    Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// One row per registered browser/device. A user can have several (phone +
// laptop, or a re-registered token after clearing site data), so this is
// a list, not a single column on User. Firebase issues a new token when an
// old one goes stale — we upsert on `token` so re-registration doesn't
// create duplicates, and prune a token here if FCM reports it as
// unregistered when we try to send to it.
model PushToken {
  id    String @id @default(cuid())
  token String @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
